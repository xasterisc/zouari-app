{
  "name": "zouari-app",
  "version": "2.0.0",
  "private": true,
  "description": "Full-stack TypeScript monorepo with Next.js, Fastify, tRPC, and BullMQ",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10.20.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome check --diagnostic-level=warn .",
    "test": "turbo test",
    "format": "biome check --apply-unsafe .",
    "clean": "turbo clean && rm -rf node_modules",
    "type-check": "turbo run type-check",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.1",
    "@types/node": "^22.18.12",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
