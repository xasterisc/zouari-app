{
  "name": "zouari-app",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack TypeScript monorepo with Next.js, Fastify, tRPC, and BullMQ",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome check --diagnostic-level=warn .",
    "test": "turbo test",
    "format": "biome check --apply-unsafe .",
    "clean": "turbo clean && rm -rf node_modules",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.1",
    "@types/node": "^22.18.12",
    "turbo": "^2.5.8",
    "typescript": "^5.9",
    "vitest": "^4.0.4"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
