{
  "name": "@zouari-app/env",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@infisical/sdk": "^4.0.6",
    "@zouari-app/validation": "workspace:*",
    "@zouari-app/logger": "workspace:*",
    "@zouari-app/errors": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "typescript": "^5.9.0",
    "vitest": "^4.0.6"
  }
}
