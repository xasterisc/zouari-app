{
  "extends": "../../config/tsconfig.base.json",
  "compilerOptions": {
    // --- Enable JS/Map Emission for this library ---
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // --- Monorepo Build Optimizations ---
    "composite": true,
    "incremental": true,

    // --- Output Directories ---
    "outDir": "./dist",
    "rootDir": "./src"
  },
  // --- Files to Include/Exclude ---
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
