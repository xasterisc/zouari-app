{
  "extends": "../../config/tsconfig.base.json",
  "compilerOptions": {
    // --- Enable JS/Map Emission for this library ---
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // --- Output Directories ---
    "outDir": "./dist",
    "rootDir": "./src",

    // --- React/JSX Settings ---
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    // --- Module System ---
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
