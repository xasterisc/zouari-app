{
  "extends": "../../config/tsconfig.base.json",
  "compilerOptions": {
    // --- Overrides for a buildable Node.js package ---
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // --- Output Configuration ---
    "outDir": "./dist",
    "rootDir": "./src",

    // --- Modern ESM & Node.js Settings ---
    // "NodeNext" is the correct setting for server-side packages
    // that use "type": "module" in their package.json.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // --- Type Definitions ---
    // Include Node.js-specific types
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
