{
  "extends": "../../config/tsconfig.base.json",
  "compilerOptions": {
    // --- Enable JS/Map Emission ---
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // --- Output Directories ---
    "outDir": "./dist",

    // --- Explicitly include Node types ---
    "types": ["node"]
  },
  // --- Files to Include/Exclude ---
  "include": ["src", "*.ts"], // Include src/ and root .ts files
  "exclude": ["node_modules", "dist"]
}
