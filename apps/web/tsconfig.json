{
  "extends": "../../config/tsconfig.base.json",
  "compilerOptions": {
    // --- Next.js Application ---
    "composite": false,
    "incremental": false,

    // --- Next.js Requirements ---
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
