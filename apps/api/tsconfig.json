{
  "extends": "../../config/tsconfig.base.json",
  "compilerOptions": {
    // --- Application Overrides ---
    "noEmit": false,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // --- Module System ---
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
